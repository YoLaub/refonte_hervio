---
import BaseLayout from '../layouts/BaseLayout.astro';
import DoctolibCTA from '../components/DoctolibCTA.astro';
import { site, practitioners, adresseComplete } from '../data/site';

const mapsQuery = encodeURIComponent(`${site.nom}, ${adresseComplete}`);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
---

<BaseLayout
  title="Contact"
  description="Contacter le cabinet de sages-femmes de Vannes : 53 avenue Edouard Herriot, 56000 Vannes. Prise de rendez-vous en ligne sur Doctolib."
>
  <section class="bg-brand-100/60">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <h1 class="text-3xl font-bold text-brand-800 md:text-4xl">Contact &amp; rendez-vous</h1>
    </div>
  </section>

  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 md:grid-cols-2">
    <div class="rounded-2xl border border-brand-100 bg-white p-8">
      <h2 class="font-serif text-xl text-brand-700">Coordonnées</h2>
      <address class="mt-4 not-italic leading-relaxed text-brand-800">
        <strong>{site.nom}</strong><br />
        {adresseComplete}
      </address>
      <ul class="mt-4 space-y-2">
        {practitioners.map((p) => (
          <li class="text-brand-800">
            {p.nom}<br />
            <a class="text-lg font-medium text-brand-600 underline" href={`tel:${p.telHref}`}>{p.tel}</a>
          </li>
        ))}
      </ul>
      <a class="mt-6 inline-block rounded-lg bg-white px-5 py-3 font-medium text-brand-700 ring-1 ring-brand-200 transition hover:bg-brand-50" href={mapsUrl} rel="noopener" target="_blank">
        Voir sur la carte →
      </a>
    </div>

    <div class="rounded-2xl bg-brand-50 p-8">
      <h2 class="font-serif text-xl text-brand-700">Prendre rendez-vous en ligne</h2>
      <p class="mt-3 text-brand-800">
        Les rendez-vous se prennent en ligne sur Doctolib, auprès de la sage-femme de votre choix.
      </p>
      <div class="mt-5"><DoctolibCTA /></div>
      <p class="mt-6 text-sm text-brand-700/80">
        Vous pouvez aussi nous joindre par téléphone aux numéros ci-contre.
      </p>
      <a class="mt-4 inline-block text-brand-600 underline" href={site.facebook} rel="noopener" target="_blank">Suivez-nous sur Facebook →</a>
    </div>
  </div>
</BaseLayout>
