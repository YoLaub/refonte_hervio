---
import { categoryVisual, type Category } from '../lib/category';

interface Props {
  category: Category;
  image?: string; // chemin d'une vraie photo dans /public ; sinon illustration placeholder
  alt?: string;
  class?: string;
}
const { category, image, alt, class: className = '' } = Astro.props;
const v = categoryVisual(category);

// Jeux de tracés (style ligne, cohérents avec les autres icônes du site).
const icons: Record<string, string> = {
  grossesse: '<path d="M9 4a2 2 0 1 1 4 0 2 2 0 0 1-4 0Z"/><path d="M11 8c0 4 4 5 4 9a4 4 0 0 1-8 0c0-2 1-3 1-5"/>',
  bebe: '<circle cx="12" cy="7" r="3"/><path d="M6 21c0-4 2.7-7 6-7s6 3 6 7"/><path d="M9 7h.01M15 7h.01"/>',
  gyneco: '<path d="M12 3v12"/><circle cx="12" cy="8" r="5"/><path d="M9 18h6M12 15v6"/>',
  acupuncture: '<path d="M12 21c4-3 7-6 7-11a7 7 0 1 0-14 0c0 5 3 8 7 11Z"/><path d="M12 3v9"/>',
};
---

<div class={`relative overflow-hidden ${className}`}>
  {image ? (
    <img src={image} alt={alt ?? v.label} loading="lazy" class="h-full w-full object-cover" />
  ) : (
    <div class={`flex h-full w-full items-center justify-center bg-gradient-to-br ${v.gradient}`} role="img" aria-label={alt ?? v.label}>
      <svg
        width="72" height="72" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
        class="text-brand-700/80"
        set:html={icons[v.icon]}
      />
    </div>
  )}
</div>
