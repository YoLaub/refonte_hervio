---
import { initials, type Practitioner } from '../data/site';

interface Props {
  practitioner: Practitioner;
}
const { practitioner: p } = Astro.props;
---

<article class="flex flex-col items-center rounded-3xl border border-brand-100 bg-white p-8 text-center shadow-sm">
  {p.photo ? (
    <img
      src={p.photo}
      alt={`Portrait de ${p.nom}, ${p.role.toLowerCase()}`}
      width="128"
      height="128"
      loading="lazy"
      class="h-32 w-32 rounded-full object-cover ring-4 ring-brand-100"
    />
  ) : (
    <div
      class="flex h-32 w-32 items-center justify-center rounded-full bg-brand-100 ring-4 ring-brand-50"
      role="img"
      aria-label={`Photo de ${p.nom} à venir`}
    >
      <span class="font-serif text-3xl font-bold text-brand-600">{initials(p.nom)}</span>
    </div>
  )}

  <h3 class="mt-5 text-xl text-brand-800">{p.nom}</h3>
  <p class="text-sm font-medium uppercase tracking-wide text-accent-600">{p.role}</p>

  {p.presentation && <p class="mt-3 text-sm leading-relaxed text-brand-800">{p.presentation}</p>}

  <div class="mt-5 flex flex-col items-center gap-2">
    <a class="text-brand-600 underline" href={`tel:${p.telHref}`}>{p.tel}</a>
    <a
      href={p.doctolib}
      rel="noopener"
      target="_blank"
      class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-brand-700"
      aria-label={`Prendre rendez-vous avec ${p.nom} sur Doctolib`}
    >
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" />
      </svg>
      Prendre rendez-vous
    </a>
  </div>
</article>
