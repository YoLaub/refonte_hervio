---
import { site, practitioners, adresseComplete } from '../data/site';
import { nav } from '../data/nav';
---

<footer class="mt-20 border-t border-brand-100 bg-brand-800 text-brand-50">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 md:grid-cols-3">
    <div>
      <h2 class="font-serif text-lg">Le cabinet</h2>
      <address class="mt-3 not-italic text-sm leading-relaxed text-brand-100">
        {site.praticiennes}<br />
        {adresseComplete}
      </address>
      <ul class="mt-3 space-y-1 text-sm">
        {practitioners.map((p) => (
          <li>
            {p.nom} —
            <a class="underline decoration-brand-400 hover:text-white" href={`tel:${p.telHref}`}>{p.tel}</a>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-xs text-brand-200">{site.convention}</p>
    </div>

    <nav aria-label="Plan du site" class="text-sm">
      <h2 class="font-serif text-lg">Prestations</h2>
      <ul class="mt-3 space-y-1">
        {nav.filter((g) => g.label !== 'Accueil').map((g) => (
          <li>
            <a class="hover:text-white" href={g.href ?? g.children?.[0]?.href}>{g.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="text-sm">
      <h2 class="font-serif text-lg">Rendez-vous</h2>
      <p class="mt-3 text-brand-100">Prise de rendez-vous en ligne sur Doctolib :</p>
      <ul class="mt-2 space-y-1">
        {practitioners.map((p) => (
          <li><a class="underline decoration-brand-400 hover:text-white" href={p.doctolib} rel="noopener" target="_blank">{p.nom}</a></li>
        ))}
      </ul>
      <a class="mt-4 inline-block hover:text-white" href={site.facebook} rel="noopener" target="_blank">Facebook →</a>
    </div>
  </div>

  <div class="border-t border-brand-700/60 px-6 py-4 text-center text-xs text-brand-300">
    © {new Date().getFullYear()} {site.nom} — {site.praticiennes}.
  </div>
</footer>
